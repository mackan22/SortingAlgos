iterations=0
def comparativeCheck(list):
    global iterations
    iterations+=1
    sorted=True
    for i in range(0,len(list)-1):
        if list[i]>list[i+1]:
            sorted=False
    return sorted


def bubbleSort(list):
    localList = list.copy()
    global iterations
    sorted=False
    while not sorted:
        iterations += 1
        sorted=True
        for i in range(0,len(localList)-1):
            if localList[i]>localList[i+1]:
                temp = localList[i]
                localList[i] = localList[i+1]
                localList[i+1] = temp
                sorted=False         
    return localList


