def radixSort(list):
    newList=[]
    oldList = list.copy()
    for k in range(0,3):
        newList=[]
        for i in range(0,10):
            for j in range(len(oldList)):
                temp = str(oldList[j])
                if len(temp)-k-1 < 0:
                    if i == 0:
                        newList.append(oldList[j])
                else:
                    tempInt = int(temp[len(temp)-k-1])
                    if tempInt == i:
                        newList.append(oldList[j])
        oldList=newList
    print(newList)
    
